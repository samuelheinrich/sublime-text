# FortiOS syntax demonstration — fictional values, no usable credentials.
config global
    config system interface
        edit "wan1"
            set alias "Internet uplink"
            set ip 192.0.2.2 255.255.255.252
            set allowaccess ping https ssh
            set role wan
        next
        edit "lan"
            set alias "Office LAN"
            set ip 10.20.0.1 255.255.255.0
            set ip6 2001:db8:20::1/64
            set status enable
        next
    end
end
config vdom
edit "lab"
    config firewall address
        edit "Office subnet"
            set subnet 10.20.0.0 255.255.255.0
            set uuid 00000000-0000-0000-0000-000000000001
        next
    end
    config firewall policy
        edit 10
            set name "Office to Internet"
            set srcintf "lan"
            set dstintf "wan1"
            set srcaddr "Office subnet"
            set dstaddr "all"
            set action accept
            set schedule "always"
            set service "HTTPS" "DNS"
            set nat enable
            set logtraffic all
            set status enable
        next
        edit 20
            set name "Block legacy access"
            set srcintf "wan1"
            set dstintf "lan"
            set srcaddr "all"
            set dstaddr "all"
            set action deny
            set status disable
        next
    end
    config vpn certificate local
        edit "Demo certificate"
            set certificate "-----BEGIN CERTIFICATE-----
DEMONSTRATION_ONLY_NOT_A_CERTIFICATE
THIS_TEXT_IS_MUTED_AND_FOLDED
-----END CERTIFICATE-----"
        next
    end
    config system replacemsg http "demo-page"
        set buffer "<html>
<body>
<h1>Demonstration page</h1>
<p>Long text can be folded without affecting FortiOS blocks.</p>
</body>
</html>"
    end
end
